{
  "cases": [
    {
      "name": "t2v: duration/size defaults and the mandatory ratio",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "baseUrl": "https://api.modelverse.cn",
          "apiKey": "sk-test",
          "model": "MiniMax-H3",
          "upstreamModel": "MiniMax-H3",
          "action": "text_to_video",
          "requestBody": {
            "model": "MiniMax-H3",
            "prompt": "一只猫在草地上奔跑",
            "duration": 4,
            "size": "720p"
          }
        }
      ],
      "expected": {
        "url": "https://api.modelverse.cn/v1/tasks/submit",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "Authorization": "Bearer sk-test"
        },
        "body": {
          "model": "MiniMax-H3",
          "input": {
            "content": [
              {
                "type": "text",
                "text": "一只猫在草地上奔跑"
              }
            ]
          },
          "parameters": {
            "resolution": "768P",
            "duration": 4,
            "ratio": "16:9"
          }
        },
        "action": "text_to_video"
      }
    },
    {
      "name": "t2v: 2K tier with an explicit ratio",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "baseUrl": "https://api.modelverse.cn",
          "apiKey": "sk-test",
          "upstreamModel": "MiniMax-H3",
          "requestBody": {
            "prompt": "城市夜景航拍",
            "duration": 10,
            "size": "2k",
            "ratio": "9:16"
          }
        }
      ],
      "expected": {
        "url": "https://api.modelverse.cn/v1/tasks/submit",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "Authorization": "Bearer sk-test"
        },
        "body": {
          "model": "MiniMax-H3",
          "input": {
            "content": [
              {
                "type": "text",
                "text": "城市夜景航拍"
              }
            ]
          },
          "parameters": {
            "resolution": "2K",
            "duration": 10,
            "ratio": "9:16"
          }
        },
        "action": "text_to_video"
      }
    },
    {
      "name": "i2v: one image becomes first_frame and ratio is omitted",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "baseUrl": "https://api.modelverse.cn",
          "apiKey": "sk-test",
          "upstreamModel": "MiniMax-H3",
          "requestBody": {
            "prompt": "让画面里的船动起来",
            "duration": 4,
            "images": [
              "https://cdn.example.com/first.png"
            ],
            "ratio": "9:16"
          }
        }
      ],
      "expected": {
        "url": "https://api.modelverse.cn/v1/tasks/submit",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "Authorization": "Bearer sk-test"
        },
        "body": {
          "model": "MiniMax-H3",
          "input": {
            "content": [
              {
                "type": "image_url",
                "image_url": {
                  "url": "https://cdn.example.com/first.png"
                },
                "role": "first_frame"
              },
              {
                "type": "text",
                "text": "让画面里的船动起来"
              }
            ]
          },
          "parameters": {
            "resolution": "768P",
            "duration": 4
          }
        },
        "action": "image_to_video"
      }
    },
    {
      "name": "i2v: two images become first_frame and last_frame",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "baseUrl": "https://api.modelverse.cn",
          "apiKey": "sk-test",
          "upstreamModel": "MiniMax-H3",
          "requestBody": {
            "prompt": "从白天过渡到夜晚",
            "duration": 5,
            "images": [
              "https://cdn.example.com/first.png",
              "https://cdn.example.com/last.png"
            ]
          }
        }
      ],
      "expected": {
        "url": "https://api.modelverse.cn/v1/tasks/submit",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "Authorization": "Bearer sk-test"
        },
        "body": {
          "model": "MiniMax-H3",
          "input": {
            "content": [
              {
                "type": "image_url",
                "image_url": {
                  "url": "https://cdn.example.com/first.png"
                },
                "role": "first_frame"
              },
              {
                "type": "image_url",
                "image_url": {
                  "url": "https://cdn.example.com/last.png"
                },
                "role": "last_frame"
              },
              {
                "type": "text",
                "text": "从白天过渡到夜晚"
              }
            ]
          },
          "parameters": {
            "resolution": "768P",
            "duration": 5
          }
        },
        "action": "image_to_video"
      }
    },
    {
      "name": "r2v: three or more images become reference images",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "baseUrl": "https://api.modelverse.cn",
          "apiKey": "sk-test",
          "upstreamModel": "MiniMax-H3",
          "requestBody": {
            "prompt": "同一位角色在城市里行走",
            "duration": 5,
            "images": [
              "https://cdn.example.com/1.png",
              "https://cdn.example.com/2.png",
              "https://cdn.example.com/3.png"
            ]
          }
        }
      ],
      "expected": {
        "url": "https://api.modelverse.cn/v1/tasks/submit",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "Authorization": "Bearer sk-test"
        },
        "body": {
          "model": "MiniMax-H3",
          "input": {
            "content": [
              {
                "type": "image_url",
                "image_url": {
                  "url": "https://cdn.example.com/1.png"
                },
                "role": "reference_image"
              },
              {
                "type": "image_url",
                "image_url": {
                  "url": "https://cdn.example.com/2.png"
                },
                "role": "reference_image"
              },
              {
                "type": "image_url",
                "image_url": {
                  "url": "https://cdn.example.com/3.png"
                },
                "role": "reference_image"
              },
              {
                "type": "text",
                "text": "同一位角色在城市里行走"
              }
            ]
          },
          "parameters": {
            "resolution": "768P",
            "duration": 5
          }
        },
        "action": "reference_to_video"
      }
    },
    {
      "name": "r2v: metadata.content passes reference video and image through",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "baseUrl": "https://api.modelverse.cn",
          "apiKey": "sk-test",
          "upstreamModel": "MiniMax-H3",
          "requestBody": {
            "prompt": "让画面里的人跳起来",
            "duration": 4,
            "metadata": {
              "content": [
                {
                  "type": "image_url",
                  "url": "https://cdn.example.com/ref.png"
                },
                {
                  "type": "video_url",
                  "url": "https://cdn.example.com/ref.mp4"
                }
              ]
            }
          }
        }
      ],
      "expected": {
        "url": "https://api.modelverse.cn/v1/tasks/submit",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "Authorization": "Bearer sk-test"
        },
        "body": {
          "model": "MiniMax-H3",
          "input": {
            "content": [
              {
                "type": "image_url",
                "image_url": {
                  "url": "https://cdn.example.com/ref.png"
                },
                "role": "reference_image"
              },
              {
                "type": "video_url",
                "video_url": {
                  "url": "https://cdn.example.com/ref.mp4"
                },
                "role": "reference_video"
              },
              {
                "type": "text",
                "text": "让画面里的人跳起来"
              }
            ]
          },
          "parameters": {
            "resolution": "768P",
            "duration": 4
          }
        },
        "action": "reference_to_video"
      }
    },
    {
      "name": "metadata.content with an explicit first_frame omits ratio",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "baseUrl": "https://api.modelverse.cn",
          "apiKey": "sk-test",
          "upstreamModel": "MiniMax-H3",
          "requestBody": {
            "prompt": "让画面动起来",
            "duration": 4,
            "metadata": {
              "content": [
                {
                  "type": "image_url",
                  "url": "https://cdn.example.com/first.png",
                  "role": "first_frame"
                }
              ]
            }
          }
        }
      ],
      "expected": {
        "url": "https://api.modelverse.cn/v1/tasks/submit",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "Authorization": "Bearer sk-test"
        },
        "body": {
          "model": "MiniMax-H3",
          "input": {
            "content": [
              {
                "type": "image_url",
                "image_url": {
                  "url": "https://cdn.example.com/first.png"
                },
                "role": "first_frame"
              },
              {
                "type": "text",
                "text": "让画面动起来"
              }
            ]
          },
          "parameters": {
            "resolution": "768P",
            "duration": 4
          }
        },
        "action": "image_to_video"
      }
    },
    {
      "name": "duration outside 4-15 is rejected",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "baseUrl": "https://api.modelverse.cn",
          "apiKey": "sk-test",
          "upstreamModel": "MiniMax-H3",
          "requestBody": {
            "prompt": "x",
            "duration": 3
          }
        }
      ],
      "expected": null,
      "expectedError": "duration must be an integer between 4 and 15 seconds"
    },
    {
      "name": "adaptive ratio is rejected for text-to-video",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "baseUrl": "https://api.modelverse.cn",
          "apiKey": "sk-test",
          "upstreamModel": "MiniMax-H3",
          "requestBody": {
            "prompt": "x",
            "duration": 4,
            "ratio": "adaptive"
          }
        }
      ],
      "expected": null,
      "expectedError": "ratio must not be adaptive for text-to-video; pick one of 16:9, 4:3, 1:1, 3:4, 9:16, 21:9"
    },
    {
      "name": "frames cannot be mixed with reference media",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "baseUrl": "https://api.modelverse.cn",
          "apiKey": "sk-test",
          "upstreamModel": "MiniMax-H3",
          "requestBody": {
            "prompt": "x",
            "duration": 4,
            "metadata": {
              "content": [
                {
                  "type": "image_url",
                  "url": "https://cdn.example.com/first.png",
                  "role": "first_frame"
                },
                {
                  "type": "image_url",
                  "url": "https://cdn.example.com/ref.png",
                  "role": "reference_image"
                }
              ]
            }
          }
        }
      ],
      "expected": null,
      "expectedError": "first_frame/last_frame cannot be mixed with reference media"
    },
    {
      "name": "resolutions below 768P are rejected instead of silently downgraded",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "baseUrl": "https://api.modelverse.cn",
          "apiKey": "sk-test",
          "upstreamModel": "MiniMax-H3",
          "requestBody": {
            "prompt": "x",
            "duration": 4,
            "size": "480p"
          }
        }
      ],
      "expected": null,
      "expectedError": "unsupported resolution 480p; MiniMax-H3 supports 768P or 2K"
    },
    {
      "name": "more than nine input images is rejected",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "baseUrl": "https://api.modelverse.cn",
          "apiKey": "sk-test",
          "upstreamModel": "MiniMax-H3",
          "requestBody": {
            "prompt": "x",
            "duration": 4,
            "images": [
              "https://cdn.example.com/1.png",
              "https://cdn.example.com/2.png",
              "https://cdn.example.com/3.png",
              "https://cdn.example.com/4.png",
              "https://cdn.example.com/5.png",
              "https://cdn.example.com/6.png",
              "https://cdn.example.com/7.png",
              "https://cdn.example.com/8.png",
              "https://cdn.example.com/9.png",
              "https://cdn.example.com/10.png"
            ]
          }
        }
      ],
      "expected": null,
      "expectedError": "too many input images (10, max 9)"
    },
    {
      "name": "i2v: a multipart image upload becomes the first frame placeholder",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "baseUrl": "https://api.modelverse.cn",
          "apiKey": "sk-test",
          "upstreamModel": "MiniMax-H3",
          "action": "image_to_video",
          "requestBody": {
            "prompt": "让画面动起来",
            "duration": 4
          },
          "files": [
            {
              "ref": "request_file:image",
              "field": "image",
              "filename": "first.png",
              "mimeType": "image/png",
              "size": 1024
            }
          ]
        }
      ],
      "expected": {
        "url": "https://api.modelverse.cn/v1/tasks/submit",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "Authorization": "Bearer sk-test"
        },
        "body": {
          "model": "MiniMax-H3",
          "input": {
            "content": [
              {
                "type": "image_url",
                "image_url": {
                  "url": {
                    "__fileRef": "request_file:image",
                    "encoding": "dataUrl"
                  }
                },
                "role": "first_frame"
              },
              {
                "type": "text",
                "text": "让画面动起来"
              }
            ]
          },
          "parameters": {
            "resolution": "768P",
            "duration": 4
          }
        },
        "action": "image_to_video"
      }
    },
    {
      "name": "submit success returns the upstream task id with the raw envelope",
      "hook": "parseSubmitResponse",
      "args": [
        {},
        {
          "statusCode": 200,
          "headers": {},
          "body": {
            "output": {
              "task_id": "h3-123"
            },
            "request_id": "req-1"
          }
        }
      ],
      "expected": {
        "taskId": "h3-123",
        "taskData": {
          "output": {
            "task_id": "h3-123"
          },
          "request_id": "req-1"
        }
      }
    },
    {
      "name": "submit failure surfaces the upstream code and message",
      "hook": "parseSubmitResponse",
      "args": [
        {},
        {
          "statusCode": 400,
          "headers": {},
          "body": {
            "error": {
              "message": "[trace_id: x] Invalid param: concentration is required",
              "type": "invalid_request_error",
              "code": "param_error"
            }
          }
        }
      ],
      "expected": null,
      "expectedError": "param_error: [trace_id: x] Invalid param: concentration is required"
    },
    {
      "name": "poll: Pending maps to QUEUED",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "output": {
            "task_id": "t-1",
            "task_status": "Pending"
          }
        }
      ],
      "expected": {
        "status": "QUEUED"
      }
    },
    {
      "name": "poll: Running maps to IN_PROGRESS",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "output": {
            "task_id": "t-1",
            "task_status": "Running"
          }
        }
      ],
      "expected": {
        "status": "IN_PROGRESS"
      }
    },
    {
      "name": "poll: Success returns the first url",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "output": {
            "task_id": "t-1",
            "task_status": "Success",
            "urls": [
              "https://algeng-video-infer.oss-cn-shanghai.aliyuncs.com/out.mp4?Expires=1&Signature=x"
            ]
          },
          "usage": {
            "duration": 4,
            "output_video_duration": 4,
            "size": "768P"
          }
        }
      ],
      "expected": {
        "status": "SUCCESS",
        "url": "https://algeng-video-infer.oss-cn-shanghai.aliyuncs.com/out.mp4?Expires=1&Signature=x"
      }
    },
    {
      "name": "poll: Failure carries the upstream reason",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "output": {
            "task_id": "t-1",
            "task_status": "Failure",
            "error_message": "task failed, reason:content[0].image_url: media not accessible (HTTP 403)"
          }
        }
      ],
      "expected": {
        "status": "FAILURE",
        "reason": "task failed, reason:content[0].image_url: media not accessible (HTTP 403)"
      }
    },
    {
      "name": "poll: Expired without a message converges to FAILURE",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "output": {
            "task_id": "t-1",
            "task_status": "Expired"
          }
        }
      ],
      "expected": {
        "status": "FAILURE",
        "reason": "task expired"
      }
    },
    {
      "name": "poll: unknown state converges to UNKNOWN",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "output": {
            "task_id": "t-1",
            "task_status": "Weird"
          }
        }
      ],
      "expected": {
        "status": "UNKNOWN",
        "reason": "unrecognized task status: Weird"
      }
    },
    {
      "name": "usage facts at submit mirror the submitted parameters",
      "hook": "extractUsage",
      "args": [
        {
          "usagePurpose": "facts",
          "requestBody": {
            "prompt": "七张参考图",
            "duration": 5,
            "size": "2K",
            "images": [
              "https://cdn.example.com/1.png",
              "https://cdn.example.com/2.png",
              "https://cdn.example.com/3.png",
              "https://cdn.example.com/4.png",
              "https://cdn.example.com/5.png",
              "https://cdn.example.com/6.png",
              "https://cdn.example.com/7.png"
            ]
          }
        }
      ],
      "expected": {
        "seconds": 5,
        "resolution": "2K",
        "input_images": 2
      }
    },
    {
      "name": "billing_ratios is not served by this plugin",
      "hook": "extractUsage",
      "args": [
        {
          "usagePurpose": "billing_ratios",
          "requestBody": {
            "prompt": "x",
            "duration": 5
          }
        }
      ],
      "expected": null
    },
    {
      "name": "completion facts use the upstream billed seconds",
      "hook": "extractUsageOnComplete",
      "args": [
        {
          "status": "SUCCESS"
        },
        {},
        {
          "output": {
            "task_id": "t-1",
            "task_status": "Success",
            "urls": [
              "https://x/out.mp4"
            ]
          },
          "usage": {
            "duration": 4,
            "output_video_duration": 4,
            "size": "768P",
            "ratio": "16:9"
          }
        }
      ],
      "expected": {
        "seconds": 4
      }
    },
    {
      "name": "completion falls back to output_video_duration",
      "hook": "extractUsageOnComplete",
      "args": [
        {
          "status": "SUCCESS"
        },
        {},
        {
          "output": {
            "task_id": "t-1",
            "task_status": "Success"
          },
          "usage": {
            "output_video_duration": 9
          }
        }
      ],
      "expected": {
        "seconds": 9
      }
    },
    {
      "name": "completion without usage keeps the submission facts",
      "hook": "extractUsageOnComplete",
      "args": [
        {
          "status": "FAILURE"
        },
        {},
        {
          "output": {
            "task_id": "t-1",
            "task_status": "Failure"
          }
        }
      ],
      "expected": {}
    },
    {
      "name": "artifacts only exist for successful tasks",
      "hook": "listArtifacts",
      "args": [
        {
          "status": "SUCCESS",
          "data": {
            "output": {
              "task_id": "t-1",
              "task_status": "Success",
              "urls": [
                "https://x/out.mp4"
              ]
            }
          }
        }
      ],
      "expected": [
        {
          "key": "video",
          "type": "video"
        }
      ]
    },
    {
      "name": "artifacts are empty while the task is running",
      "hook": "listArtifacts",
      "args": [
        {
          "status": "IN_PROGRESS",
          "data": {
            "output": {
              "task_id": "t-1",
              "task_status": "Running"
            }
          }
        }
      ],
      "expected": []
    },
    {
      "name": "the video artifact is fetched credentialless from the signed url",
      "hook": "buildContentRequest",
      "args": [
        {
          "artifactKey": "video",
          "data": {
            "output": {
              "task_id": "t-1",
              "task_status": "Success",
              "urls": [
                "https://x/out.mp4?sig=1"
              ]
            }
          },
          "clientRequest": {
            "method": "GET"
          }
        }
      ],
      "expected": {
        "url": "https://x/out.mp4?sig=1",
        "method": "GET",
        "credentialless": true
      }
    },
    {
      "name": "unknown artifact keys are rejected",
      "hook": "buildContentRequest",
      "args": [
        {
          "artifactKey": "audio",
          "data": {
            "output": {
              "urls": [
                "https://x/out.mp4"
              ]
            }
          },
          "clientRequest": {
            "method": "GET"
          }
        }
      ],
      "expected": null,
      "expectedError": "artifact_not_found"
    }
  ]
}
